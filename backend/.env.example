PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=file:./dev.db
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (image uploads)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Media Engine
MEDIA_ENGINE_URL=http://localhost:8001
# Token compartido con el media-engine (obligatorio en producción)
MEDIA_ENGINE_TOKEN=

# Trust proxy: 1 si estás detrás de Cloudflare/Render (IP real del cliente),
# 0 si el puerto está expuesto directo a internet (evita spoofing de IP).
TRUST_PROXY=1

# PayPal (pagos de suscripciones/regalos/donaciones)
# OBLIGATORIOS en producción: sin ellos la pasarela devuelve 503 y no hay pagos.
# Consíguelos en https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# PAYPAL_STRICT=true fuerza modo estricto (rechaza pagos simulados) incluso en dev
PAYPAL_STRICT=false

# Seed de admin (script de bootstrap, no producción):
# SEED_ADMIN_EMAIL=admin@gremioestelar.com
# SEED_ADMIN_PASSWORD=CambiaEstaClaveSegura123
