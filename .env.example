# ==================================================
# Gremio Estelar — Root Environment Variables Example
# Copy this file to .env and fill in your values
# ==================================================

# --- Database ---
DATABASE_URL="file:./dev.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- Backend Server ---
PORT=4000
NODE_ENV=development
# FRONTEND_URL: tu dominio público (obligatorio en producción para CORS/WebSocket)
# Ej: https://gremio.tudominio.com
FRONTEND_URL=http://localhost:3000
# TRUST_PROXY: 1 (default en producción) si estás detrás de Cloudflare Tunnel/Render
# (permite leer la IP real del cliente y HTTPS). 0 si el puerto está expuesto directo.
TRUST_PROXY=1

# --- JWT Secrets (OBLIGATORIOS en producción — valores aleatorios fuertes) ---
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend ---
# Deja vacío para usar rutas relativas (/api) vía el rewrite de Next.js
# (recomendado: funciona para usuarios remotos sin exponer la API).
# Alternativa: tu dominio público, ej: https://gremio.tudominio.com/api
NEXT_PUBLIC_API_BASE_URL=
# Google OAuth Client ID (público, visible en el navegador)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Media Engine ---
MEDIA_ENGINE_URL=http://media-engine:8001
# Token compartido backend ↔ media-engine (obligatorio si el engine está expuesto públicamente)
MEDIA_ENGINE_TOKEN=

# --- Cloudflare Tunnel ---
TUNNEL_TOKEN=

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=gremioweb
POSTGRES_USER=gremio_user
POSTGRES_PASSWORD=

# --- Seed de admin (opcional, solo script de bootstrap) ---
# Si se omite, se genera una contraseña aleatoria (se imprime una sola vez).
# SEED_ADMIN_PASSWORD=CambiaEstaClaveSegura123
# SEED_ADMIN_EMAIL=admin@gremioestelar.com
