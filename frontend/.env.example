[TEMPLATE]
# Deja vacío para usar rutas relativas (/api) — solo si el frontend corre en
# el MISMO contenedor que el backend (monolito). Si el frontend es un servicio
# separado, apunta al backend público, ej:
# NEXT_PUBLIC_API_BASE_URL=https://gremio-web.onrender.com/api
NEXT_PUBLIC_API_BASE_URL=

# Host del servidor Socket.IO (OBLIGATORIO si el frontend está separado del
# backend; se inlaya en el build, así que configúralo como BUILD ARG en Render).
# Ej: NEXT_PUBLIC_SOCKET_URL=https://gremio-web.onrender.com  (sin /api, sin barra final)
# Si se deja vacío, se deriva de NEXT_PUBLIC_API_BASE_URL quitando /api, y si
# tampoco hay, usa la misma origin de la página.
NEXT_PUBLIC_SOCKET_URL=

# Google OAuth Client ID (público, visible en el navegador)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
